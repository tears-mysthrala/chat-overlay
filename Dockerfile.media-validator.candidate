# Candidate only: Dockerfile.media-validator stays byte-identical because it is
# bound to the approved historical artifact. Needs its own human approval. Refs #46, #50.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS build
RUN apk add --no-cache build-base zlib-dev=1.3.2-r1
ADD --checksum=sha256:2b31a7f7474680138b5b96cd60f21f2a96c63075cefc11a637c00d12742dd7c1 https://codeload.github.com/FFmpeg/FFmpeg/tar.gz/e5a08f7c0e45e6d278a394ef19c97f0b8ad3ed45 /source.tar.gz
RUN mkdir /source && tar -xzf /source.tar.gz -C /source --strip-components=1
WORKDIR /source
RUN ./configure --prefix=/opt/ffmpeg --disable-autodetect --disable-everything \
    --disable-doc --disable-debug --disable-network --disable-asm \
    --enable-ffmpeg --enable-ffprobe --enable-avcodec --enable-avformat \
    --enable-avfilter --enable-swscale --enable-swresample --enable-zlib \
    --enable-protocol=file,pipe \
    --enable-decoder=png,gif,webp,mp3,mp3float,vorbis,opus,pcm_s16le,pcm_s24le,pcm_f32le,rawvideo,wrapped_avframe \
    --enable-demuxer=image2,image2pipe,image_png_pipe,image_webp_pipe,gif,wav,mp3,ogg,matroska \
    --enable-parser=gif,png,webp \
    --enable-encoder=png,pcm_s16le,gif \
    --enable-muxer=image2,wav,gif,matroska \
    --enable-filter=aresample,format,aformat,scale,color,sine,anull,null \
    --enable-indev=lavfi && make -j2 && make install
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS python-patched
RUN apk add --no-cache python3=3.14.10-r1 patch
ADD --checksum=sha256:4fae8dc3af30ad4accf6dd20cbd6c80c7882900bb91684072a9ea3475768068c https://codeload.github.com/python/cpython/tar.gz/refs/tags/v3.14.10 /python-source.tar.gz
RUN mkdir /python-source && tar -xzf /python-source.tar.gz -C /python-source --strip-components=1
COPY vendor/media/python/b234a2b67539f787e191d2ef19a7cbdce32874e7.patch /patches/
COPY vendor/media/python/SHA256SUMS /patches.sums
WORKDIR /python-source
RUN grep b234a2b /patches.sums | (cd /patches && sha256sum -c -) \
    && patch --fuzz=0 -p1 < /patches/b234a2b67539f787e191d2ef19a7cbdce32874e7.patch
COPY scripts/test_decoder_python_patches.py /test-patches.py
USER 65532:65532
WORKDIR /tmp
RUN PYTHONPATH=/python-source/Lib python3 /test-patches.py

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache python3=3.14.10-r1 zlib=1.3.2-r1 libcrypto3=3.5.9-r0 libssl3=3.5.9-r0 musl=1.2.6-r3 musl-utils=1.2.6-r3
COPY --from=build /opt/ffmpeg/bin/ /usr/local/bin/
COPY --from=build /source/COPYING.LGPLv2.1 /usr/share/licenses/ffmpeg/COPYING.LGPLv2.1
COPY --from=python-patched /python-source/Lib/poplib.py /usr/lib/python3.14/
COPY --from=python-patched /python-source/LICENSE /usr/share/licenses/python-patches/LICENSE
COPY vendor/media/python/b234a2b67539f787e191d2ef19a7cbdce32874e7.patch /usr/share/python-patches/
COPY scripts/media_build_inventory.py /build-inventory.py
RUN python3 -I /build-inventory.py
LABEL org.opencontainers.image.source="https://github.com/FFmpeg/FFmpeg" \
      org.opencontainers.image.revision="e5a08f7c0e45e6d278a394ef19c97f0b8ad3ed45"
COPY scripts/media_validator.py /validator.py
USER 65532:65532
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python3", "-I", "/validator.py"]
