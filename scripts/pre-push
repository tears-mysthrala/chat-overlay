#!/usr/bin/env bash
# Pre-push local: replica los gates de CI antes de subir. Instalación una vez por clon:
#   scripts/install-hooks.sh
# Alcance: SIEMPRE formato, trazabilidad, secretos, estática y mix check; build + smoke +
# auditoría de imagen (SBOM/Grype) además cuando cambia el empaquetado. La CI sigue siendo
# la puerta exigible; saltar el hook (--no-verify) debe justificarse en la PR.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

need() { command -v "$1" >/dev/null 2>&1 || { echo "pre-push: falta '$1' en el PATH" >&2; exit 1; }; }
need git
need python3
need mix

refs="$(cat)"

echo "pre-push: formato, trazabilidad, secretos, estática"
mix format --check-formatted
python3 scripts/check_traceability.py
python3 scripts/scan_secrets.py
python3 scripts/security_static.py

echo "pre-push: mix check"
mix check

changed=""
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    if base="$(git merge-base "$local_oid" origin/main 2>/dev/null)" && [ -n "$base" ]; then
      changed="$changed $(git diff --name-only "$base" "$local_oid")"
    else
      changed="$changed $(git ls-tree -r --name-only "$local_oid")"
    fi
  else
    changed="$changed $(git diff --name-only "$remote_oid" "$local_oid")"
  fi
done <<< "$refs"
changed="$(echo "$changed" | tr ' ' '\n' | sort -u)"

packaging="$(echo "$changed" | grep -E '^(Dockerfile|\.dockerignore|mix\.exs|mix\.lock|\.tool-versions|vex\.openvex\.json|config/|lib/|priv/|vendor/|scripts/(audit_image\.py|smoke_image\.py|inventory\.exs))' || true)"

if [ -n "$packaging" ]; then
  need docker
  echo "pre-push: cambia empaquetado -> build + smoke + auditoría de imagen"
  docker build -t chat-overlay:prepush .
  python3 scripts/smoke_image.py chat-overlay:prepush
  audit_venv="${XDG_CACHE_HOME:-$HOME/.cache}/chat-overlay-audit"
  if [ ! -x "$audit_venv/bin/python" ]; then
    python3 -m venv "$audit_venv"
    "$audit_venv/bin/python" -m pip install -q jsonschema==4.26.0 referencing==0.37.0
  fi
  "$audit_venv/bin/python" scripts/audit_image.py chat-overlay:prepush
fi

echo "pre-push: OK"
